PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# 32+ caractères aléatoires : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h
# true = autoriser de nouvelles inscriptions (sinon seul le 1er compte peut être créé)
ALLOW_REGISTRATION=false
# Origines frontend supplémentaires, séparées par des virgules
FRONTEND_URL=
